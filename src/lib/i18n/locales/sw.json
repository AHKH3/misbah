            },
            {
                "question": "Je, Misbah inashughulikia malipo?",
                "answer": "Hapana. Mkataba wowote wa kifedha kati ya mwanafunzi na mwalimu ni huru kabisa kutoka Misbah."
            },
            {
                "question": "Ninawezaje kujiunga kama mwalimu?",
                "answer": "Unaweza kuomba kupitia ukurasa wa usajili. Tutapitia ombi lako na kuwasiliana nawe."
            },
            {
                "question": "Je, kuna ada kwa wanafunzi?",
                "answer": "Hapana. Kuvinjari na kupata maelezo ya walimu ni bure kabisa kwa wanafunzi."
            },
            {
                "question": "Je, kuna ada kwa walimu?",
                "answer": "Ndiyo, kuna usajili wa kila mwaka wa ishara kwa walimu baada ya ombi lao kukubaliwa."
            }
